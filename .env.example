# H5 uses a same-origin /api proxy. Server-side only, never a database address.
VITE_API_PROXY_TARGET=http://127.0.0.1:18084
# For App / mini-program deployments, set a reachable business API origin.
# VITE_API_BASE_URL=https://your-knowledge-api.example

# Optional H5 static resource prefix; leave / for the local preview.
VITE_WEB_BASE=/
