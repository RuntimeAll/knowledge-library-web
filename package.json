{
  "name": "knowledge-library-web",
  "version": "0.1.0",
  "scripts": {
    "dev": "uni --host 127.0.0.1 --port 5193",
    "build": "uni build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src tests tools vite.config.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "node tests/smoke.mjs",
    "dev:h5": "uni --host 127.0.0.1 --port 5193",
    "build:h5": "uni build -p h5",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "dev:app": "uni -p app",
    "build:app": "uni build -p app",
    "build:all": "npm run build:h5 && npm run build:mp-weixin && npm run build:app",
    "test:skeleton": "node tests/skeleton.mjs",
    "prepare:assets": "node tools/prepare-icons.mjs",
    "predev": "npm run prepare:assets",
    "predev:h5": "npm run prepare:assets",
    "predev:mp-weixin": "npm run prepare:assets",
    "predev:app": "npm run prepare:assets",
    "prebuild": "npm run prepare:assets",
    "prebuild:h5": "npm run prepare:assets",
    "prebuild:mp-weixin": "npm run prepare:assets",
    "prebuild:app": "npm run prepare:assets",
    "pretype-check": "npm run prepare:assets",
    "format": "prettier --write src tests tools vite.config.ts",
    "test:architecture": "node tools/check-boundaries.mjs",
    "test:admin": "node tests/admin-flow.mjs",
    "preview:h5": "vite preview --outDir dist/build/h5 --host 0.0.0.0 --port 5193 --strictPort",
    "test:client-ui": "node tests/client-ui.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030420261029002",
    "@dcloudio/uni-app-plus": "3.0.0-5030420261029002",
    "@dcloudio/uni-components": "3.0.0-5030420261029002",
    "@dcloudio/uni-h5": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030420261029002",
    "pinia": "2.1.7",
    "uview-plus": "3.8.136",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5030420261029002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030420261029002",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.58.2",
    "@types/node": "22.18.0",
    "@vue/runtime-core": "3.4.21",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.5.1",
    "prettier": "3.6.2",
    "sass": "1.77.8",
    "tsx": "4.20.6",
    "typescript": "5.6.3",
    "typescript-eslint": "8.46.3",
    "vite": "5.2.8",
    "vue-tsc": "2.1.10"
  },
  "private": true,
  "description": "知识库用户端 · uni-app 三端页面骨架",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RuntimeAll/knowledge-library-web.git"
  }
}
